NODE_ENV=development
PORT=5001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_tracker
CLIENT_ORIGIN=http://localhost:5173
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
# Prefer IAM roles in production. Local SDK credentials may use the standard names:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Legacy AWS_ACCESS_KEY/AWS_SECRET_KEY names remain supported for S3 only.
AI_MODE=demo
# Set only when intentionally enabling paid AI and consenting to sharing resume text:
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
EMAIL_PROVIDER=console
# EMAIL_FROM=verified-sender@example.com
