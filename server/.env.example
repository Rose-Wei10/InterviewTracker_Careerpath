NODE_ENV=development
PORT=5001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_tracker
CLIENT_ORIGIN=http://localhost:5173
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
# Prefer IAM roles in production. Local SDK credentials may use the standard names:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Legacy AWS_ACCESS_KEY/AWS_SECRET_KEY names remain supported for S3 only.
# Resume reviews are free and rule-based. No AI provider or API key is used.
EMAIL_PROVIDER=console
# EMAIL_FROM=verified-sender@example.com

# New uploads default to private Blob. Explicit s3 is only for pre-cutover/local use.
RESUME_STORAGE_PROVIDER=blob

# Connected Vercel projects supply BLOB_STORE_ID and OIDC.
# Local Blob access requires an authorized private store token; never commit it.
# BLOB_READ_WRITE_TOKEN=
