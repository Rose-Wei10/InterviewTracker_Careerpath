{
  "manifest_version": 3,
  "name": "Careerpath Apply Kit",
  "version": "2.0.0",
  "description": "Preview and fill selected application answers locally.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "side_panel": {
    "default_path": "panel.html"
  }
}
